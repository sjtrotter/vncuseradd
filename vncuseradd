#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="1.3.0"
readonly ERR_NO_VNCSRV=64
readonly ERR_UNK_OPT=65
readonly ERR_NO_LOGIN=66
readonly ERR_FILE_WRITE=68
readonly VNC_USER_CONFIG="/etc/tigervnc/vncserver.users"
readonly MIN_DISPLAY=10
readonly VNC_PORT_BASE=5900
readonly SYS_PASS_LEN=20
readonly VNC_PASS_LEN=8
# Unambiguous alphabet: no 0/O/o, no 1/l/I, no special chars.
# Safe inside chpasswd's colon-separated records and in shell pipelines.
readonly PASS_CHARSET='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789'
readonly ANSI_RED='\033[1;31m'
readonly ANSI_CLEAR='\033[0m'
readonly ANSI_YELLOW='\033[1;93m'
readonly PROG="${0##*/}"

ADMIN=""
CREDS_FILE=""
START_SVC=""
DEBUG=""
ARGS=()
CURRENT_SYS_USERS=()
CURRENT_VNC_USERS=()
CURRENT_VNC_DISPLAYS=()
ENABLE_UNITS=()
START_UNITS=()
REPORT_USERS=()
declare -A USER_SYS_PASS=()
declare -A USER_VNC_PASS=()
declare -A USER_PORT=()

finish () {
    local rc="$1"
    local msg="${2:-}"
    if (( rc > 0 )); then
        printf "${ANSI_RED}%s: %s${ANSI_CLEAR}\n" "$PROG" "$msg" >&2
        printf 'Try: %s -h\n' "$PROG" >&2
    fi
    exit "$rc"
}

usage () {
    echo
    # BEGIN GENERATED:NAME
    cat <<'GENEOF'
vncuseradd - add new LOGIN(s) with VNC capabilities
GENEOF
    # END GENERATED:NAME
    cat <<EOF
* needs TigerVNC Server installed with config at ${VNC_USER_CONFIG}
* random passwords are generated and printed to stdout (system password is
  expired on first login; rotate VNC password with vncpasswd)

EOF
    # BEGIN GENERATED:SYNOPSIS
    cat <<'GENEOF'
Usage: vncuseradd [OPTION]... LOGIN [LOGIN]...
GENEOF
    # END GENERATED:SYNOPSIS
    cat <<'EOF'

Options:
EOF
    # BEGIN GENERATED:OPTIONS
    cat <<'GENEOF'
  -a            make the LOGIN(s) an admin account (adds user(s) to wheel
                group)
  -o FILE       also write generated credentials to FILE (created with mode
                0600). Without this flag, credentials are printed to stdout
                only.
  -h            Display the help message.
  -s            Starts the VNC service(s) now (otherwise reboot or start
                manually)
  -v            Turn on debug mode.
  -V            Display version.
GENEOF
    # END GENERATED:OPTIONS
    echo
}

debug () {
    [[ -n $DEBUG ]] || return 0
    printf "${ANSI_YELLOW}[-]${ANSI_CLEAR} %s\n" "$1" >&2
}

version () {
    printf '%s\n' "$VERSION"
}

gen_password () {
    local len="$1"
    local raw
    # Read 16x bytes from /dev/urandom and filter to charset; head -c
    # bounds the read so no SIGPIPE on tr under pipefail.
    raw=$(LC_ALL=C tr -dc "$PASS_CHARSET" < <(head -c $((len * 16)) /dev/urandom))
    printf '%s' "${raw:0:len}"
}

parse_args () {
    local optstring=":aho:svV"
    local arg
    while [[ $OPTIND -le $# ]]; do
        if getopts "$optstring" arg; then
            case "$arg" in
                a) ADMIN=1 ;;
                h) usage; finish 0 ;;
                o) CREDS_FILE="$OPTARG" ;;
                s) START_SVC=1 ;;
                v) DEBUG=1 ;;
                V) version; finish 0 ;;
                :) finish "$ERR_UNK_OPT" "option -$OPTARG requires an argument" ;;
                ?) finish "$ERR_UNK_OPT" "unknown option: -$OPTARG" ;;
            esac
        else
            ARGS+=("${!OPTIND}")
            OPTIND=$((OPTIND + 1))
        fi
    done

    if (( ${#ARGS[@]} < 1 )); then
        finish "$ERR_NO_LOGIN" "no LOGIN given"
    fi
}

preflight_creds_file () {
    [[ -z $CREDS_FILE ]] && return 0
    local dir
    dir=$(dirname -- "$CREDS_FILE")
    if [[ ! -d $dir ]]; then
        finish "$ERR_FILE_WRITE" "credentials file directory does not exist: $dir"
    fi
    if ! touch "$CREDS_FILE" 2>/dev/null; then
        finish "$ERR_FILE_WRITE" "cannot create credentials file: $CREDS_FILE"
    fi
    chmod 600 "$CREDS_FILE"
}

get_sysusers () {
    debug "getting system user list..."
    mapfile -t CURRENT_SYS_USERS < <(getent passwd | cut -d: -f1)
    debug "found system users: ${CURRENT_SYS_USERS[*]}"
}

get_vncusers () {
    debug "getting VNC user list..."
    CURRENT_VNC_USERS=()
    CURRENT_VNC_DISPLAYS=()
    local line
    while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        CURRENT_VNC_DISPLAYS+=("${line%%=*}")
        CURRENT_VNC_USERS+=("${line#*=}")
    done < "$VNC_USER_CONFIG"
    debug "found vnc users: ${CURRENT_VNC_USERS[*]:-}"
}

create_user () {
    local user="$1"
    local pass="$2"
    debug "creating user $user (useradd --create-home)"
    useradd --create-home --shell /bin/bash --comment "$user" "$user"
    debug "setting system password for $user via chpasswd"
    # chpasswd reads "user:password" from stdin. Our PASS_CHARSET excludes
    # colon, so the field split is unambiguous and the password never lands
    # in argv or a temp file.
    printf '%s:%s\n' "$user" "$pass" | chpasswd
}

expire_password () {
    local user="$1"
    debug "expiring system password for $user (force reset on first login)"
    passwd --expire "$user" >/dev/null
}

set_vncpasswd () {
    local user="$1"
    local pass="$2"
    debug "setting vncpasswd for $user..."
    # su -l: login shell (sets HOME, USER, SHELL for target user). -s /bin/sh:
    # don't run target's custom shell. Stdin pipe carries the password to
    # vncpasswd, which reads it twice (entry + confirmation).
    printf '%s\n%s\n' "$pass" "$pass" | su -l "$user" -s /bin/sh -c 'vncpasswd >/dev/null 2>&1'
}

write_vncconfig () {
    local user="$1"
    local display="$2"
    debug "writing vnc config for $user on display $display"
    printf '%s=%s\n' "$display" "$user" >> "$VNC_USER_CONFIG"
}

set_admin () {
    local user="$1"
    debug "making $user admin"
    usermod -aG wheel "$user"
}

next_free_display () {
    local -n taken_ref="$1"
    local n=$MIN_DISPLAY
    while [[ -n ${taken_ref[:$n]:-} ]]; do
        n=$((n + 1))
    done
    printf ':%s' "$n"
}

build_report () {
    local block user syspass vncpass port
    block=$'\nGenerated credentials (shown once; system password is expired and must be changed on first login):\n\n'
    block+=$(printf '  %-16s  %-20s  %-12s  %s\n' "LOGIN" "SYSTEM PASSWORD" "VNC PASSWORD" "VNC PORT")
    block+=$'\n'
    for user in "${REPORT_USERS[@]}"; do
        syspass="${USER_SYS_PASS[$user]:--}"
        vncpass="${USER_VNC_PASS[$user]:--}"
        port="${USER_PORT[$user]:--}"
        block+=$(printf '  %-16s  %-20s  %-12s  %s' "$user" "$syspass" "$vncpass" "$port")
        block+=$'\n'
    done
    printf '%s' "$block"
}

main () {
    # Parse args before re-exec: -h, -V, and argument errors don't need
    # root, so handling them up front means a non-root user gets help or
    # an error without an unnecessary sudo prompt.
    parse_args "$@"

    # Everything below (useradd, chpasswd, systemctl, writing to
    # $VNC_USER_CONFIG, su to other users) needs root. Re-exec once via
    # sudo instead of prefixing every call. When invoked from automation
    # that's already root (ansible become: true, or `sudo vncuseradd ...`),
    # EUID is already 0 and we skip the re-exec, so there's no double-sudo.
    if (( EUID != 0 )); then
        exec sudo -E -- "$0" "$@"
    fi

    if [[ ! -f $VNC_USER_CONFIG ]]; then
        finish "$ERR_NO_VNCSRV" "tigervnc-server config not found"
    fi

    preflight_creds_file

    get_sysusers
    get_vncusers

    declare -A sys_user_set=()
    declare -A vnc_user_set=()
    declare -A vnc_display_set=()
    local u d
    for u in "${CURRENT_SYS_USERS[@]}"; do sys_user_set[$u]=1; done
    for u in "${CURRENT_VNC_USERS[@]:-}";   do [[ -n $u ]] && vnc_user_set[$u]=1; done
    for d in "${CURRENT_VNC_DISPLAYS[@]:-}"; do [[ -n $d ]] && vnc_display_set[$d]=1; done

    local user pass
    for user in "${ARGS[@]}"; do
        if [[ -n ${sys_user_set[$user]:-} ]]; then
            debug "skipping $user, already created"
            continue
        fi
        pass=$(gen_password "$SYS_PASS_LEN")
        USER_SYS_PASS[$user]="$pass"
        create_user "$user" "$pass"
        expire_password "$user"
        [[ -n $ADMIN ]] && set_admin "$user"
    done

    local display vnc_pass
    local -a notes=()
    for user in "${ARGS[@]}"; do
        if [[ -n ${vnc_user_set[$user]:-} ]]; then
            notes+=("$user: already in VNC config, skipped")
            continue
        fi
        display=$(next_free_display vnc_display_set)
        debug "assigning display $display to $user"
        vnc_pass=$(gen_password "$VNC_PASS_LEN")
        USER_VNC_PASS[$user]="$vnc_pass"
        USER_PORT[$user]=$(( VNC_PORT_BASE + ${display#:} ))
        write_vncconfig "$user" "$display"
        vnc_display_set[$display]=1
        set_vncpasswd "$user" "$vnc_pass"
        ENABLE_UNITS+=("vncserver@${display}.service")
        [[ -n $START_SVC ]] && START_UNITS+=("vncserver@${display}.service")
        REPORT_USERS+=("$user")
    done

    if (( ${#ENABLE_UNITS[@]} > 0 )); then
        systemctl --quiet enable "${ENABLE_UNITS[@]}"
    fi
    if (( ${#START_UNITS[@]} > 0 )); then
        systemctl --quiet start "${START_UNITS[@]}"
    fi

    if (( ${#notes[@]} > 0 )); then
        printf '%s\n' "${notes[@]}"
    fi

    if (( ${#REPORT_USERS[@]} > 0 )); then
        local report
        report=$(build_report)
        printf '%s' "$report"
        if [[ -n $CREDS_FILE ]]; then
            printf '%s' "$report" > "$CREDS_FILE"
            chmod 600 "$CREDS_FILE"
            printf '\nCredentials also written to: %s (mode 0600)\n' "$CREDS_FILE"
        fi
    elif [[ -n $CREDS_FILE ]]; then
        printf 'No new credentials generated; %s left empty.\n' "$CREDS_FILE"
    fi
}

if [[ ${0##*/} == "vncuseradd" ]]; then main "$@"; fi
