#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="1.0.0"
readonly ERR_NO_VNCSRV=64
readonly ERR_UNK_OPT=65
readonly ERR_NO_LOGIN=66
readonly ERR_NO_PASSWD=67
readonly USER_FILE="/tmp/newusers"
readonly VNC_USER_CONFIG="/etc/tigervnc/vncserver.users"
readonly MIN_DISPLAY=10
readonly VNC_PORT_BASE=5900
readonly ANSI_RED='\033[1;31m'
readonly ANSI_CLEAR='\033[0m'
readonly ANSI_YELLOW='\033[1;93m'
readonly PROG="${0##*/}"

ADMIN=""
PASSWORD=""
START_SVC=""
DEBUG=""
ARGS=()
CURRENT_SYS_USERS=()
CURRENT_VNC_USERS=()
CURRENT_VNC_DISPLAYS=()
CHOWN_LIST=()
ENABLE_UNITS=()
START_UNITS=()

finish () {
    local rc="$1"
    local msg="${2:-}"
    if (( rc > 0 )); then
        printf "${ANSI_RED}%s: %s${ANSI_CLEAR}\n" "$PROG" "$msg" >&2
        printf 'Try: %s -h\n' "$PROG" >&2
    fi
    exit "$rc"
}

usage () {
    cat <<EOF

$PROG  - add new LOGIN(s) with VNC capabilities
* needs TigerVNC Server installed with config at ${VNC_USER_CONFIG}
* VNC passwords are set to 'password' by default.

Usage: $PROG [OPTION] -p PASSWORD LOGIN [LOGIN]...

Options:
EOF
    # BEGIN GENERATED:OPTIONS
    cat <<'GENEOF'
  -a            make the LOGIN(s) an admin account (adds user(s) to wheel
                group)
  -p PASSWORD   Default password of the new user(s). For more than one LOGIN,
                PASSWORD will apply to all. This input method is NOT SECURE -
                have user(s) change ASAP with passwd
  -h            Display the help message.
  -s            Starts the VNC service(s) now (otherwise reboot or start
                manually)
  -v            Turn on debug mode.
  -V            Display version.
GENEOF
    # END GENERATED:OPTIONS
    echo
}

debug () {
    [[ -n $DEBUG ]] || return 0
    printf "${ANSI_YELLOW}[-]${ANSI_CLEAR} %s\n" "$1" >&2
}

version () {
    printf '%s\n' "$VERSION"
}

parse_args () {
    local optstring=":ahp:svV"
    local arg
    while [[ $OPTIND -le $# ]]; do
        if getopts "$optstring" arg; then
            case "$arg" in
                a) ADMIN=1 ;;
                h) usage; finish 0 ;;
                p) PASSWORD="$OPTARG" ;;
                s) START_SVC=1 ;;
                v) DEBUG=1 ;;
                V) version; finish 0 ;;
                :) finish "$ERR_UNK_OPT" "option -$OPTARG requires an argument" ;;
                ?) finish "$ERR_UNK_OPT" "unknown option: -$OPTARG" ;;
            esac
        else
            ARGS+=("${!OPTIND}")
            OPTIND=$((OPTIND + 1))
        fi
    done

    if (( ${#ARGS[@]} < 1 )); then
        finish "$ERR_NO_LOGIN" "no LOGIN given"
    fi
}

get_sysusers () {
    debug "getting system user list..."
    mapfile -t CURRENT_SYS_USERS < <(getent passwd | cut -d: -f1)
    debug "found system users: ${CURRENT_SYS_USERS[*]}"
}

get_vncusers () {
    debug "getting VNC user list..."
    CURRENT_VNC_USERS=()
    CURRENT_VNC_DISPLAYS=()
    local line
    while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        CURRENT_VNC_DISPLAYS+=("${line%%=*}")
        CURRENT_VNC_USERS+=("${line#*=}")
    done < "$VNC_USER_CONFIG"
    debug "found vnc users: ${CURRENT_VNC_USERS[*]:-}"
}

write_userfile () {
    local user="$1"
    local userfile="$2"
    debug "writing $user to $userfile"
    printf '%s:%s:::%s:/home/%s:/bin/bash\n' "$user" "$PASSWORD" "$user" "$user" >> "$userfile"
}

create_home () {
    local user="$1"
    if [[ -d /home/$user ]]; then
        debug "skipping $user's homedir, already there"
        return
    fi
    debug "creating $user's homedir"
    sudo cp -r /etc/skel "/home/$user"
}

create_users () {
    local userfile="$1"
    debug "creating users from $userfile"
    sudo newusers "$userfile"
    sudo rm -f "$userfile"
}

chown_home () {
    local user="$1"
    debug "chown $user's homedir"
    sudo chown -R "$user:$user" "/home/$user"
}

set_vncpasswd () {
    local user="$1"
    debug "setting vncpasswd for $user..."
    sudo su "$user" -c 'printf "password\npassword\n" | vncpasswd >/dev/null 2>&1'
}

write_vncconfig () {
    local user="$1"
    local display="$2"
    debug "writing vnc config for $user on display $display"
    printf '%s=%s\n' "$display" "$user" | sudo tee -a "$VNC_USER_CONFIG" >/dev/null
}

set_admin () {
    local user="$1"
    debug "making $user admin"
    sudo usermod -aG wheel "$user"
}

next_free_display () {
    local -n taken_ref="$1"
    local n=$MIN_DISPLAY
    while [[ -n ${taken_ref[:$n]:-} ]]; do
        n=$((n + 1))
    done
    printf ':%s' "$n"
}

print_vnc_info () {
    local user="$1"
    local display="$2"
    printf '%s - port %s\n' "$user" "$(( VNC_PORT_BASE + ${display#:} ))"
}

main () {
    parse_args "$@"

    if [[ ! -f $VNC_USER_CONFIG ]]; then
        finish "$ERR_NO_VNCSRV" "tigervnc-server config not found"
    fi

    get_sysusers
    get_vncusers

    declare -A sys_user_set=()
    declare -A vnc_user_set=()
    declare -A vnc_display_set=()
    local u d
    for u in "${CURRENT_SYS_USERS[@]}"; do sys_user_set[$u]=1; done
    for u in "${CURRENT_VNC_USERS[@]:-}";   do [[ -n $u ]] && vnc_user_set[$u]=1; done
    for d in "${CURRENT_VNC_DISPLAYS[@]:-}"; do [[ -n $d ]] && vnc_display_set[$d]=1; done

    local user
    for user in "${ARGS[@]}"; do
        if [[ -n ${sys_user_set[$user]:-} ]]; then
            debug "skipping $user, already created"
            continue
        fi
        if [[ -z $PASSWORD ]]; then
            finish "$ERR_NO_PASSWD" "new user given with no PASSWORD"
        fi
        create_home "$user"
        write_userfile "$user" "$USER_FILE"
        CHOWN_LIST+=("$user")
    done

    if (( ${#CHOWN_LIST[@]} > 0 )); then
        create_users "$USER_FILE"
        for user in "${CHOWN_LIST[@]}"; do
            chown_home "$user"
            [[ -n $ADMIN ]] && set_admin "$user"
        done
    fi

    local -a vnc_status=()
    local display
    for user in "${ARGS[@]}"; do
        if [[ -n ${vnc_user_set[$user]:-} ]]; then
            vnc_status+=("skipping $user, already in VNC config")
            continue
        fi
        display=$(next_free_display vnc_display_set)
        debug "assigning display $display to $user"
        write_vncconfig "$user" "$display"
        vnc_display_set[$display]=1
        set_vncpasswd "$user"
        ENABLE_UNITS+=("vncserver@${display}.service")
        [[ -n $START_SVC ]] && START_UNITS+=("vncserver@${display}.service")
        vnc_status+=("$(print_vnc_info "$user" "$display")")
    done

    if (( ${#ENABLE_UNITS[@]} > 0 )); then
        sudo systemctl --quiet enable "${ENABLE_UNITS[@]}"
    fi
    if (( ${#START_UNITS[@]} > 0 )); then
        sudo systemctl --quiet start "${START_UNITS[@]}"
    fi

    printf '%s\n' "${vnc_status[@]}"
}

if [[ ${0##*/} == "vncuseradd" ]]; then main "$@"; fi
