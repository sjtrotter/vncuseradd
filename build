#!/usr/bin/env bash
# Regenerate vncuseradd.8.gz from vncuseradd.8.md and sync three blocks
# (NAME, SYNOPSIS, OPTIONS) into README.md and the usage() function in
# vncuseradd.
#
# Source of truth: vncuseradd.8.md
# Generated:       vncuseradd.8.gz
#                  the blocks between BEGIN/END GENERATED:<SECTION> markers
#                  in README.md and vncuseradd
#
# Sections wired up:
#   NAME      - "vncuseradd - tagline"        (from # NAME)
#   SYNOPSIS  - "vncuseradd [OPTION]... ..."  (from # SYNOPSIS, markup stripped)
#   OPTIONS   - the option table              (from # OPTIONS)
#
# Run with no args. Exits 0 on success (whether or not anything changed).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

readonly SRC=vncuseradd.8.md
readonly GZ=vncuseradd.8.gz
readonly SCRIPT=vncuseradd
readonly README=README.md

die () { echo "build: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 1. Regenerate the gzipped manpage.
# gzip -n is REQUIRED: without it the archive embeds the source filename
# and mtime, producing a different .gz on every run, which would defeat
# the drift detection in CI.
# ---------------------------------------------------------------------------
if command -v pandoc >/dev/null 2>&1; then
    echo "build: regenerating $GZ"
    pandoc -s -t man "$SRC" | gzip -n > "$GZ"
else
    echo "build: WARNING pandoc not installed; skipping $GZ regeneration" >&2
    echo "build: install pandoc to regenerate the manpage locally" >&2
fi

# ---------------------------------------------------------------------------
# 2. Markup stripper. Strips manpage formatting:
#   **bold**  -> bold
#   *italic*  -> italic
#   `word'    -> word   (groff-style display quote)
# ---------------------------------------------------------------------------
strip_markup () {
    sed -E "
        s/\\*\\*//g
        s/\\*//g
        s/\`([^\`]+)'/\1/g
        s/\`//g
    "
}

# ---------------------------------------------------------------------------
# 3. Generic section extractor: prints all non-blank lines between
# "# <SECTION>" and the next "# " header, with markup stripped.
# ---------------------------------------------------------------------------
extract_section () {
    local section="$1"
    awk -v sect="# $section" '
        $0 == sect    { in_sect = 1; next }
        /^# /         { in_sect = 0 }
        in_sect && NF { print }
    ' "$SRC" | strip_markup
}

# ---------------------------------------------------------------------------
# 4. OPTIONS: render as a plaintext two-column table (spec | wrapped desc).
# ---------------------------------------------------------------------------
extract_options () {
    awk '
        /^# OPTIONS/ { in_opts = 1; next }
        /^# /        { in_opts = 0 }
        !in_opts     { next }
        /^\*\*-/ {
            spec = $0
            getline desc
            sub(/^: /, "", desc)
            print spec "\t" desc
        }
    ' "$SRC" | strip_markup
}

format_options () {
    local spec desc folded first line
    while IFS=$'\t' read -r spec desc; do
        folded=$(printf '%s\n' "$desc" | fold -s -w 62 | sed 's/[[:space:]]\+$//')
        first=1
        while IFS= read -r line; do
            if (( first )); then
                printf '  %-12s  %s\n' "$spec" "$line"
                first=0
            else
                printf '  %-12s  %s\n' "" "$line"
            fi
        done <<< "$folded"
    done
}

# ---------------------------------------------------------------------------
# 5. Extract each block.
# ---------------------------------------------------------------------------
NAME_LINE=$(extract_section NAME | head -n 1)
[[ -n $NAME_LINE ]] || die "no NAME extracted from $SRC; check that # NAME section exists"

SYNOPSIS_BLOCK=$(extract_section SYNOPSIS)
[[ -n $SYNOPSIS_BLOCK ]] || die "no SYNOPSIS extracted from $SRC; check that # SYNOPSIS section exists"

OPTIONS_BLOCK=$(extract_options | format_options)
[[ -n $OPTIONS_BLOCK ]] || die "no options extracted from $SRC; check that # OPTIONS section exists"

# ---------------------------------------------------------------------------
# 6. Inject between markers in a target file.
# ---------------------------------------------------------------------------
inject () {
    local file="$1" begin="$2" end="$3" body="$4"
    grep -qF "$begin" "$file" || die "$file is missing marker: $begin"
    grep -qF "$end"   "$file" || die "$file is missing marker: $end"

    local tmp
    tmp=$(mktemp)
    awk -v begin="$begin" -v end="$end" -v body="$body" '
        function trim(s) {
            sub(/^[[:space:]]+/, "", s)
            sub(/[[:space:]]+$/, "", s)
            return s
        }
        { line = trim($0) }
        line == begin { print; print body; in_block = 1; next }
        line == end   { in_block = 0; print; next }
        !in_block     { print }
    ' "$file" > "$tmp"
    # cat-and-rm preserves the target file's mode bits (mv would clobber
    # them with mktemp's default 0600).
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

# ---------------------------------------------------------------------------
# 7. Render per-target bodies.
#
# Script bodies are wrapped in a quoted heredoc so the script's usage()
# function can cat them verbatim. README bodies are markdown:
#   NAME      - h1 title + tagline (split at the " - " separator)
#   SYNOPSIS  - fenced code block
#   OPTIONS   - fenced code block
# ---------------------------------------------------------------------------
heredoc () {
    printf "    cat <<'GENEOF'\n%s\nGENEOF" "$1"
}

# Split "vncuseradd - tagline" into title and tagline for the README header.
NAME_TITLE=${NAME_LINE%% - *}
NAME_TAGLINE=${NAME_LINE#* - }

README_NAME=$(printf '# %s\n%s' "$NAME_TITLE" "$NAME_TAGLINE")
README_SYNOPSIS=$(printf '```\n%s\n```' "$SYNOPSIS_BLOCK")
README_OPTIONS=$(printf '```\n%s\n```' "$OPTIONS_BLOCK")

SCRIPT_NAME=$(heredoc "$NAME_LINE")
SCRIPT_SYNOPSIS=$(heredoc "Usage: $SYNOPSIS_BLOCK")
SCRIPT_OPTIONS=$(heredoc "$OPTIONS_BLOCK")

# ---------------------------------------------------------------------------
# 8. Inject.
# ---------------------------------------------------------------------------
echo "build: syncing $README"
inject "$README" '<!-- BEGIN GENERATED:NAME -->'     '<!-- END GENERATED:NAME -->'     "$README_NAME"
inject "$README" '<!-- BEGIN GENERATED:SYNOPSIS -->' '<!-- END GENERATED:SYNOPSIS -->' "$README_SYNOPSIS"
inject "$README" '<!-- BEGIN GENERATED:OPTIONS -->'  '<!-- END GENERATED:OPTIONS -->'  "$README_OPTIONS"

echo "build: syncing $SCRIPT"
inject "$SCRIPT" '# BEGIN GENERATED:NAME'     '# END GENERATED:NAME'     "$SCRIPT_NAME"
inject "$SCRIPT" '# BEGIN GENERATED:SYNOPSIS' '# END GENERATED:SYNOPSIS' "$SCRIPT_SYNOPSIS"
inject "$SCRIPT" '# BEGIN GENERATED:OPTIONS'  '# END GENERATED:OPTIONS'  "$SCRIPT_OPTIONS"

echo "build: done"
